rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Изображения товаров — читать может любой авторизованный
    // пользователь приложения, писать — только через CRUD-формы,
    // размер и тип файла ограничены.
    match /products/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Документы (сканы, приложения к сделкам) — приватны, доступ
    // определяется владельцем записи; итоговая проверка — на
    // сервере при выдаче ссылок через Cloud Functions.
    match /documents/{userId}/{fileName} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
